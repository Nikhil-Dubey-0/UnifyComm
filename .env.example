# Copy to .env and fill in. Never commit .env. See ARCHITECTURE.md section 13.

# --- Database (PostgreSQL 17, native Windows service) ---
DATABASE_URL=postgresql+asyncpg://unifycomm:unifycomm@localhost:5432/unifycomm
TEST_DATABASE_URL=postgresql+asyncpg://unifycomm:unifycomm@localhost:5432/unifycomm_test

# --- Auth ---
# Replace with a long random string (e.g. python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET=change-me
JWT_EXPIRES_MINUTES=720
SEED_AGENT_PASSWORD=demo1234
CORS_ORIGINS=http://localhost:3000

# --- Local AI models ---
# fake = keyword predictors (no torch needed); real = team models in the worker
AI_MODE=fake
MODELS_DIR=./models
INTENT_MODEL_DIR=./models/intent/repro-v1
INTENT_CONFIDENCE_FLOOR=0.50
SENTIMENT_MODEL_ID=cardiffnlp/twitter-roberta-base-sentiment-latest
# Pinned Hugging Face commit (main as of 2025-08-04, pinned in Session 3)
SENTIMENT_MODEL_REVISION=3216a57f2a0d9c45a2e6c20157c20c49fb4bf9c7
TORCH_NUM_THREADS=4

# --- OpenAI (drafts and summaries) ---
OPENAI_API_KEY=
OPENAI_MODEL_DRAFT=gpt-6-luna
OPENAI_MODEL_SUMMARY=gpt-6-luna
OPENAI_TIMEOUT_SECONDS=20
LLM_ENABLED=true

# --- Conversation and compliance rules ---
CONVERSATION_REOPEN_DAYS=7
SUMMARY_EVERY_N_MESSAGES=10
BUSINESS_TIMEZONE=Asia/Kolkata
PROMO_WINDOW_START=09:00
PROMO_WINDOW_END=21:00

# --- Channel providers: simulator | twilio | gmail ---
DEFAULT_PROVIDER_WHATSAPP=simulator
DEFAULT_PROVIDER_SMS=simulator
DEFAULT_PROVIDER_EMAIL=simulator

# --- Twilio WhatsApp sandbox (Session 5) ---
# Public https tunnel URL (ngrok/cloudflared), used for webhook signature checks
PUBLIC_BASE_URL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# --- Gmail IMAP/SMTP (Session 5). Personal Gmail with 2-Step Verification + app password ---
EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=
IMAP_HOST=imap.gmail.com
SMTP_HOST=smtp.gmail.com
EMAIL_POLL_SECONDS=20

# --- Logging ---
LOG_LEVEL=INFO
